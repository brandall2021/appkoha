# Generar con: openssl rand -hex 16 (KEY), openssl rand -hex 32 (SECRET), npx web-push generate-vapid-keys (VAPID)
POSTGRES_PASSWORD=cambiar
DIRECTUS_KEY=cambiar-openssl-rand-hex-16
DIRECTUS_SECRET=cambiar-openssl-rand-hex-32
DIRECTUS_ADMIN_EMAIL=admin@institucion.edu.ar
DIRECTUS_ADMIN_PASSWORD=cambiar
PUBLIC_URL=http://localhost:8055
PUSH_SHARED_SECRET=cambiar
# Token de servicio de Directus: uuid que usa push-sender para autenticarse.
# Generar con uuidgen o openssl rand -hex 20; apply.sh lo asigna al usuario.
DIRECTUS_SERVICE_TOKEN=cambiar-con-uuid
# Generar con: npx web-push generate-vapid-keys  (pegar ambas claves completas)
VAPID_PUBLIC_KEY=cambiar
VAPID_PRIVATE_KEY=cambiar
