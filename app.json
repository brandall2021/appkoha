{
  "expo": {
    "_task10_note": "ANTES de deploy a producción: correr 'npx eas init' (requiere login Expo) y pegar el projectId en extra.eas.projectId más abajo.",
    "name": "KohaLibrary",
    "slug": "appkoha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "appkoha",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kohalibrary.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B5E20",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.kohalibrary.app",
      "predictiveBackGestureEnabled": false
    },
    "extra": {
      "eas": {
        "projectId": "COMPLETAR_CON_npx_eas_init"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Necesitamos acceso a la camara para escanear codigos ISBN y QR."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Necesitamos acceso al microfono para buscar libros por voz.",
          "speechRecognitionPermission": "Necesitamos acceso al reconocimiento de voz para buscar libros por voz.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ]
  }
}
