{
  "expo": {
    "name": "KohaLibrary",
    "slug": "appkoha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "appkoha",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kohalibrary.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B5E20",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.kohalibrary.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Necesitamos acceso a la camara para escanear codigos ISBN y QR."
        }
      ]
    ]
  }
}
